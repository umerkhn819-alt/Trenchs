# Production client env vars.
#
# NOTE: Only NEXT_PUBLIC_* values belong here. These are compiled into the
# browser bundle and are public by design — no secrets. Real secrets
# (service role key, admin password/JWT) live in Supabase, never here.
#
# Vercel dashboard env vars take precedence over this file, so you can still
# override any of these per-environment without touching the repo.

NEXT_PUBLIC_SITE_URL=https://trenchlabs.com
NEXT_PUBLIC_API_URL=https://vvdhwgxmypokwgvwlizp.supabase.co/functions/v1/api
NEXT_PUBLIC_SUPABASE_URL=https://vvdhwgxmypokwgvwlizp.supabase.co
